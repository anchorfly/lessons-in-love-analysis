    {
      "en": "scene mollymaya23",
      "cap": true,
      "zh": ""
    },
    {
      "img": "游戏图片/Events/mollymaya23.webp",
      "alt": "mollymaya23"
    },
    {
      "en": ""
    },
    {
      "en": ": Your personality can be mimicked by any prepubescent boy in Japan. You aren’t as unique as you think.",
      "spk": "Maya",
      "spkColor": "#20EF00",
      "zh": ""
    },
    {
      "en": ": Do you hear something, Sir? The wind is certainly loud today.",
