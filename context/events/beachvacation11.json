      "img": "游戏图片/Events/mollymaya28.webp",
      "alt": "mollymaya28"
    },
    {
      "en": ""
    },
    {
      "en": ": Oh no...No...",
      "spk": "Maya",
      "spkColor": "#20EF00",
      "zh": ""
    },
    {
      "en": ": This can’t be happening.",
