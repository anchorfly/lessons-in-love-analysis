      "spkColor": "#20EF00",
      "zh": ""
    },
    {
      "en": ""
    },
    {
      "en": "scene mollymaya25",
      "cap": true,
      "zh": ""
    },
    {
      "img": "游戏图片/Events/mollymaya25.webp",
      "alt": "mollymaya25"
    },
    {
      "en": ""
    },
    {
      "en": ": In fact, it’s almost unnerving how-",
