    },
    {
      "en": ""
    },
    {
      "en": "scene mollymaya24",
      "cap": true,
      "zh": ""
    },
    {
      "img": "游戏图片/Events/mollymaya24.webp",
      "alt": "mollymaya24"
    },
    {
      "en": ""
    },
    {
      "en": ": Maya?",
