    },
    {
      "img": "游戏图片/Events/mollymaya32.webp",
      "alt": "mollymaya32"
    },
    {
      "en": ""
    },
    {
      "en": ": No, you don’t understand! If you blow up the watermelon, Maya will get really upset!",
      "spk": "Ami",
      "spkColor": "#FF4DD2",
      "zh": ""
    },
    {
      "en": ": They need to be cut into perfect wedges or else she gets super cranky.",
      "spk": "Ami",
      "spkColor": "#FF4DD2",
