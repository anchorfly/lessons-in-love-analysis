    {
      "en": ": Chika Chosokabe — your attendance is required for the Transpacific Sadness Symposium in nineteen years, eleven days, six hours, and fourty-four minutes.",
      "spk": "Voice Over PA",
      "spkColor": "#e6e6e6",
      "zh": ""
