    {
      "en": "scene utasekai32",
      "cap": true,
      "zh": ""
    },
    {
      "img": "游戏图片/Events/utasekai32.webp",
      "alt": "utasekai32"
    },
    {
      "en": ""
    },
    {
      "en": ": Okay. Message sent. I will now go back to focusing entirely on Uta-chan.",
      "spk": "Sensei",
      "spkColor": "#969696",
      "zh": ""
    },
    {
      "en": ": Um...",
