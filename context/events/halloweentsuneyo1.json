      "zh": ""
    },
    {
      "en": ": Hey, aren’t these kind of huge for your age? Are you sure you’re who you say you are? You’re positive you didn’t just lose track of time cooped up in that ramen shop?",
      "spk": "Sekai",
      "spkColor": "#FF0055",
      "zh": ""
