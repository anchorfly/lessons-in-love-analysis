    },
    {
      "img": "游戏图片/Events/mollydrunkagain14.webp",
      "alt": "mollydrunkagain14"
    },
    {
      "en": ""
    },
    {
      "en": ": Unbelievable! Kids these days! Always on their phones and not even payin’ attention to ta world around ‘em.",
      "spk": "Molly",
      "spkColor": "#4FCB80",
      "zh": ""
    },
    {
      "en": ": You are...not one to speak.",
      "spk": "Sensei",
