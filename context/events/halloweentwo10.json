    {
      "img": "游戏图片/Events/mollydrunkagain5.webp",
      "alt": "mollydrunkagain5"
    },
    {
      "en": ""
    },
    {
      "en": ": She here now? Or is she a...*hic* traitor who left me all alone to go talk to my arch nemesis?",
      "spk": "Molly",
      "spkColor": "#4FCB80",
      "zh": ""
    },
