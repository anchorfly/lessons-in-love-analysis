    {
      "en": ": Hey, Ami. Are you in there?",
      "spk": "Sensei",
      "spkColor": "#969696",
      "zh": ": 喂，Ami。你在里面吗？"
    },
    {
      "en": ": Mhm! Come in, Sensei!",
      "spk": "Ami",
      "spkColor": "#FF4DD2",
      "zh": ": 嗯！请进，Sensei！"
    },
    {
      "en": ""
    },
