    {
      "en": ": Hey, Maya. Are you around right now?",
      "spk": "Sensei",
      "spkColor": "#969696",
      "zh": ": 嘿，Maya。你现在在吗？"
    },
    {
      "en": ": Why are you here? Please leave.",
      "spk": "Maya",
      "spkColor": "#20EF00",
      "zh": ": 你为什么在这儿？请离开。"
    },
    {
      "en": ": What's that? You want me to come in?",
      "spk": "Sensei",
      "spkColor": "#969696",
      "zh": ": 你说什么？你想让我进去？"
    },
    {
      "en": ""
    },
