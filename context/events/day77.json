      "zh": ""
    },
    {
      "en": ""
    },
    {
      "en": "scene amimak20",
      "cap": true,
      "zh": ""
    },
    {
      "img": "游戏图片/Events/amimak20.webp",
      "alt": "amimak20"
    },
    {
      "en": ""
    },
    {
      "en": ": Hah...how about we just take a break instead?",
      "spk": "Makoto",
      "spkColor": "#5D84FF",
      "zh": ""
    },
    {
      "en": "mak \"We’ve been at this for an hour and haven’t really gotten anywhere, so maybe",
      "zh": ""
    },
    {
