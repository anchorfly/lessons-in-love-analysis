    },
    {
      "en": ""
    },
    {
      "en": ": How are you feeling? Are you okay? Do you need me to hit you again?",
      "spk": "Ayane",
      "spkColor": "#00BAB1",
      "zh": ""
    },
    {
      "en": ": No...I don’t need to you to hit me.",
