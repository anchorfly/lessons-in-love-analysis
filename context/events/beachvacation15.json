      "spkColor": "#AF7F00",
      "zh": ""
    },
    {
      "en": ": Don’t you?",
      "spk": "Chika",
      "spkColor": "#AF7F00",
      "zh": ""
    },
    {
      "en": ""
    },
    {
      "en": ""
    },
    {
      "en": ": I’m in love with you.",
