      "zh": ""
    },
    {
      "img": "游戏图片/Events/battletwo30.webp",
      "alt": "battletwo30"
    },
    {
      "en": ""
    },
    {
      "en": ": Pray to whichever god you believe in, Master Arakawa...",
      "spk": "Ayane",
      "spkColor": "#00BAB1",
      "zh": ""
    },
    {
      "en": ": Your time on this planet ends now...",
      "spk": "Ayane",
