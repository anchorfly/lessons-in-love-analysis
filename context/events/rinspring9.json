      "zh": ""
    },
    {
      "en": ": Wow! Sugoi! Tastes just like NOTHING!",
      "spk": "Sensei",
      "spkColor": "#969696",
      "zh": ""
    },
    {
      "en": ": You’ve gotta try this, Rin! It’ll make you super meccha happy! aND IF IT doesn’t, there are other parfaits! Right, Chinko?",
      "spk": "Sensei",
      "spkColor": "#969696",
