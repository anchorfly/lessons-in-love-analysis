    {
      "en": ": Hello? Sensei?",
      "spk": "Makoto",
      "spkColor": "#5D84FF",
      "zh": ": 喂？老师？"
    },
    {
      "en": ": What's going on? Do you need something?",
      "spk": "Makoto",
      "spkColor": "#5D84FF",
      "zh": ": 怎么了？你需要什么吗？"
    },
    {
      "en": ": Need? No. Want? Yes.",
      "spk": "Sensei",
      "spkColor": "#969696",
      "zh": ": 需要？不。想要？是的。"
    },
    {
      "en": ": ...Is that some sort of code?",
      "spk": "Makoto",
      "spkColor": "#5D84FF",
      "zh": ": ……那是什么暗号吗？"
    },
    {
      "en": ": What do you want from me?",
      "spk": "Makoto",
      "spkColor": "#5D84FF",
      "zh": ": 你想从我这儿要什么？"
    },
    {
      "en": ": I want you to come over.",
      "spk": "Sensei",
      "spkColor": "#969696",
      "zh": ": 我想让你过来。"
    },
    {
      "en": ": Then just say that...",
      "spk": "Makoto",
      "spkColor": "#5D84FF",
      "zh": ": 那你直说就行了……"
    },
    {
      "en": ": Thankfully, I'm off tonight.",
      "spk": "Makoto",
      "spkColor": "#5D84FF",
      "zh": ": 幸好我今晚休息。"
    },
    {
      "en": ": Just give me a few minutes and I'll start heading over.",
      "spk": "Makoto",
      "spkColor": "#5D84FF",
      "zh": ": 给我几分钟，我就出发。"
