    {
      "en": ": Tell me immediately, miniature human cyclops girl!",
      "spk": "Kaori",
      "spkColor": "#969696",
      "zh": ""
    },
    {
      "en": ": I D-D-D-DON’T KNOW ANY HAMBURGER MAN! I SAID I’M SORRY! PLEASE DON'T HURT ME!",
      "spk": "Sana",
      "spkColor": "#00E77F",
      "zh": ""
