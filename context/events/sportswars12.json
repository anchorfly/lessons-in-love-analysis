      "img": "游戏图片/Events/deathball1.webp",
      "alt": "deathball1"
    },
    {
      "en": ""
    },
    {
      "en": ": Whaaaaaaaat the fuck is that thing?",
      "spk": "Otoha",
      "spkColor": "#FF569D",
      "zh": ""
    },
    {
      "en": ": Large and in charge. Let’s bake this bread.",
      "spk": "Tsuneyo",
      "spkColor": "#C8B330",
      "zh": ""
    },
    {
      "en": ": It’s...",
      "spk": "Uta",
      "spkColor": "#EF61BF",
      "zh": ""
    },
    {
      "en": ": It’s beautiful...",
      "spk": "Uta",
      "spkColor": "#EF61BF",
      "zh": ""
    },
    {
      "en": ""
    },
    {
      "en": "scene black",
      "cap": true,
