      "img": "游戏图片/Events/anotherbottlespin1.webp",
      "alt": "anotherbottlespin1"
    },
    {
      "en": ""
    },
    {
      "en": ": Aaaaah! Fine! I have nothing left to lose!",
      "spk": "Rin",
      "spkColor": "#FF00AE",
