    },
    {
      "en": ""
    },
    {
      "en": ": Oh, shoot! I wasn’t even thinking! I’m so sorry!",
      "spk": "Chika",
      "spkColor": "#AF7F00",
      "zh": ""
    },
    {
      "en": ""
    },
    {
      "en": "scene ringlow27",
      "cap": true,
      "zh": ""
    },
    {
      "img": "游戏图片/Events/ringlow27.webp",
      "alt": "ringlow27"
    },
    {
      "en": ""
    },
    {
      "en": ": Heheh...hahahaha! It’s fine...it’s fine.",
