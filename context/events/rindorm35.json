    },
    {
      "en": "scene ringlow18",
      "cap": true,
      "zh": ""
    },
    {
      "img": "游戏图片/Events/ringlow18.webp",
      "alt": "ringlow18"
    },
    {
      "en": ""
    },
    {
      "en": ": That’s not true...I look like this all the time.",
