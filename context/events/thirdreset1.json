      "zh": ""
    },
    {
      "img": "游戏图片/Misc/black.png",
      "alt": "black"
    },
    {
      "en": ""
    },
    {
      "en": "I fall.",
      "zh": ""
    },
    {
      "en": ""
    },
    {
      "en": "$ god_love = 0",
      "zh": ""
    },
    {
      "en": ""
    },
    {
      "en": "Your affection with God GOD has been reset to 0!",
      "zh": ""
    },
    {
      "en": "You are going to Hell!",
      "zh": ""
    },
    {
      "en": ".........",
      "zh": ""
    },
    {
      "en": "......",
      "zh": ""
    },
    {
      "en": "...",
      "zh": ""
    },
    {
