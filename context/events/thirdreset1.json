      "zh": "//////////////////////////USER2 已夺取 23 号终端的控制权"
    },
    {
      "en": "//////////////////////////USER2 WOULD LIKE TO OPEN CHAT",
      "zh": "//////////////////////////USER2 想要发起聊天"
    },
    {
      "en": "//////////////////////////DO YOU ACCEPT?",
      "zh": "//////////////////////////是否接受？"
    },
    {
      "en": ""
    },
    {
      "en": "menu:",
      "zh": ""
    },
    {
      "en": "Yes",
      "zh": "是"
    },
    {
