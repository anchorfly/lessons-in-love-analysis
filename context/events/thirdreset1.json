    {
      "en": ""
    },
    {
      "en": ": I’m home!~",
      "spk": "Sensei",
      "spkColor": "#969696",
      "zh": ""
    },
    {
      "en": ""
    },
    {
      "en": "I walk into the living room with a pep in my step and heart full of blood.",
      "zh": ""
    },
    {
      "en": ""
    },
    {
      "en": ": How’s everybody doing?",
      "spk": "Sensei",
      "spkColor": "#969696",
      "zh": ""
    },
    {
      "en": ""
    },
    {
      "en": "No one responds because no one is here.",
      "zh": ""
    },
    {
      "en": ""
    },
    {
      "en": "I take off my shirt and walk around the house naked, hoping that someone comes home and sees me.",
      "zh": ""
    },
    {
      "en": "Unfortunately, no one does.",
      "zh": ""
    },
    {
      "en": "I do this for at least two hours before I decide to give up.",
      "zh": ""
    },
    {
      "en": ""
    },
    {
      "en": "scene helloandwelcometohouse2",
      "cap": true,
      "zh": ""
    },
    {
      "img": "游戏图片/Events/helloandwelcometohouse2.webp",
      "alt": "helloandwelcometohouse2"
    },
    {
      "en": ""
    },
    {
      "en": ": Ami?",
