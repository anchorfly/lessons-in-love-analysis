      "zh": ""
    },
    {
      "img": "游戏图片/Events/tsuneyokaori22.webp",
      "alt": "tsuneyokaori22"
    },
    {
      "en": ""
    },
    {
      "en": ": Kaori, that’s not the proper response to “Thank you.”",
