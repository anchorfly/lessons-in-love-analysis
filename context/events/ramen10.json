      "spkColor": "#C8B330",
      "zh": ""
    },
    {
      "en": ""
    },
    {
      "en": "if kaoridate1 == True:",
      "zh": ""
    },
    {
      "en": ": That’s going to be your new nickname from now on. I can’t even remember how long I was stuck with Hamburger Man for.",
      "spk": "Sensei",
      "spkColor": "#969696",
      "zh": ""
    },
    {
      "en": ""
    },
    {
      "en": "else:",
