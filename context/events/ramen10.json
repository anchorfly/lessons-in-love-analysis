      "spkColor": "#969696",
      "zh": ""
    },
    {
      "en": ""
    },
    {
      "en": "scene tsuneyokaori19",
      "cap": true,
      "zh": ""
    },
    {
      "img": "游戏图片/Events/tsuneyokaori19.webp",
      "alt": "tsuneyokaori19"
    },
    {
      "en": ""
    },
    {
      "en": ": Nothing?...",
      "spk": "Kaori",
      "spkColor": "#969696",
      "zh": ""
    },
    {
      "en": ": That’s good. It means there is still room in your heart to accept the one true savior.",
