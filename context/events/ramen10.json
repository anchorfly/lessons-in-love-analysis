      "spkColor": "#969696",
      "zh": ""
    },
    {
      "en": ": I see.",
      "spk": "Tsuneyo",
      "spkColor": "#C8B330",
      "zh": ""
    },
    {
      "en": ": I, Tsuneyo Tojo, love animals. Let this fact be known.",
      "spk": "Tsuneyo",
      "spkColor": "#C8B330",
      "zh": ""
    },
    {
      "en": ""
