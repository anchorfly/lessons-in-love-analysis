      "alt": "tsuneyokaori25"
    },
    {
      "en": ""
    },
    {
      "en": ": What do you think you’re doing? I will not agree to work with someone who would not agree to work with me under different circumstances.",
      "spk": "Kaori",
      "spkColor": "#969696",
