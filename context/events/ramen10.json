    {
      "en": ": I am Kaori Kadowaki! The Queen of Spiders! The Mistress of the Dark!",
      "spk": "Kaori",
      "spkColor": "#969696",
      "zh": ""
    },
    {
      "en": ": And I am Tsuneyo Tojo, the quirky and fun-loving Flavor Samurai.",
