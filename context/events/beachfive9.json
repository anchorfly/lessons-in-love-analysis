    {
      "en": ": How...what...huh? Huh?!?!",
      "spk": "Futaba",
      "spkColor": "#E73CFF",
      "zh": ""
    },
    {
      "en": ": There are ghosts inside this building. They will attempt to speak to you. Do not look at them. Do not answer them. Do not pass go. Do not collect $200.",
      "spk": "Voice Over PA",
      "spkColor": "#e6e6e6",
      "zh": ""
    },
    {
      "en": ": Your attendance is requested for the Transpacific Sadness Symposium. Please come to the library for further details.",
