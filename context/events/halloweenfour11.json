    },
    {
      "en": ""
    },
    {
      "en": ": Eep!",
      "spk": "Sana",
      "spkColor": "#00E77F",
      "zh": ""
    },
    {
      "en": ": Oh my God — Sana?!",
      "spk": "Rin",
      "spkColor": "#FF00AE",
      "zh": ""
    },
    {
      "en": ": Too...hot...can’t...ngh...can’t...breathe...",
